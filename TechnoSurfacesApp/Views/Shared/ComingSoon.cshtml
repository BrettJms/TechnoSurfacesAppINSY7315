@{
    var summary = ViewData["Summary"] as string ?? "";
    var contents = ViewData["Contents"] as string[] ?? Array.Empty<string>();
}

<div class="page-head">
    <div>
        <h2>@ViewData["Title"]</h2>
        <p>@summary</p>
    </div>
    <div class="page-head-actions">
        <a class="btn btn-secondary" asp-controller="Home" asp-action="Dashboard">
            <svg class="ico ico-sm"><use href="#i-arrow-left" /></svg> Dashboard
        </a>
    </div>
</div>

<div class="card content-narrow">
    <div class="card-head">
        <svg class="ico" style="color:var(--ts-blue)"><use href="#i-info" /></svg>
        <h3>Screen in build</h3>
    </div>
    <div class="card-body">
        <p class="muted small" style="margin-top:0">
            This screen is part of the prototype and is being built next. It will contain:
        </p>
        <ul style="margin:0;padding-left:20px">
            @foreach (var c in contents)
            {
                <li class="small" style="padding:4px 0">@c</li>
            }
        </ul>
    </div>
    <div class="card-foot">
        <a class="btn btn-primary btn-sm" asp-controller="Home" asp-action="Dashboard">Back to dashboard</a>
        <a class="btn btn-ghost btn-sm" asp-controller="Quotes" asp-action="Index">All quotes</a>
    </div>
</div>