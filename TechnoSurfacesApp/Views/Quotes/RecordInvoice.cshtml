@model TechnoSurfacesApp.Controllers.RecordInvoiceVm
@{
    var q = Model.Quote;
}

<div class="page-head">
    <div>
        <h2>Record Pastel invoice</h2>
        <p>@q.Ref &middot; @Db.CustomerName(q.CustomerId)</p>
    </div>
    <div class="page-head-actions">
        <a class="btn btn-secondary" asp-action="Costing" asp-route-id="@q.Id">
            <svg class="ico ico-sm"><use href="#i-arrow-left" /></svg> Costing sheet
        </a>
    </div>
</div>

<partial name="_QuoteHeader" model="q" />

<div class="notice notice-info">
    <svg class="ico"><use href="#i-info" /></svg>
    <div>
        <strong>Pastel remains the book of record.</strong>
        Tax invoices, VAT and sequential numbering stay in Sage Pastel Partner. This screen records
        the invoice reference against the quote so the link from quote to invoice stays traceable.
    </div>
</div>

<div class="grid grid-main">
    <div>
        <div class="card">
            <div class="card-head">
                <svg class="ico" style="color:var(--ts-blue)"><use href="#i-file" /></svg>
                <h2>Invoice details</h2>
                @if (Model.IsRecorded)
                {
                    <span class="spacer"></span>
                    <span class="badge badge-sage">Recorded</span>
                }
            </div>
            <div class="card-body">
                <div class="field-row field-row-2">
                    <div class="field">
                        <label class="label" for="invno">Pastel invoice number <span class="req">*</span></label>
                        <input class="input" id="invno" value="@q.PastelInvoiceNo" placeholder="IN000000" />
                        <div class="hint">As it appears on the Pastel document, e.g. IN114317</div>
                    </div>
                    <div class="field">
                        <label class="label" for="invdate">Invoice date <span class="req">*</span></label>
                        <input class="input" id="invdate" type="date"
                               value="@(q.PastelInvoiceDate?.ToString("yyyy-MM-dd") ?? DateTime.Today.ToString("yyyy-MM-dd"))" />
                    </div>
                </div>

                <div class="field-row field-row-2">
                    <div class="field">
                        <label class="label" for="invamt">Invoice amount incl VAT <span class="req">*</span></label>
                        <div class="input-group">
                            <span class="addon" style="border-left:1px solid var(--line);border-right:none;border-radius:var(--r-sm) 0 0 var(--r-sm)">R</span>
                            <input class="input input-num" id="invamt" type="number" step="0.01"
                                   style="border-radius:0 var(--r-sm) var(--r-sm) 0"
                                   value="@(q.PastelInvoiceAmount?.ToString(System.Globalization.CultureInfo.InvariantCulture))" />
                        </div>
                    </div>
                    <div class="field">
                        <label class="label" for="pastelacct">Pastel account code</label>
                        <input class="input" id="pastelacct" value="@Db.GetCustomer(q.CustomerId)?.AccountCode" disabled />
                        <div class="hint">From the customer record</div>
                    </div>
                </div>

                <div class="field">
                    <label class="label" for="invnote">Note</label>
                    <textarea class="input" id="invnote" rows="2"
                              placeholder="Anything worth recording about this invoice"></textarea>
                </div>
            </div>
            <div class="card-foot">
                <button class="btn btn-primary" type="button">
                    @(Model.IsRecorded ? "Update invoice record" : "Record invoice")
                </button>
                <a class="btn btn-ghost" asp-action="Index">Cancel</a>
            </div>
        </div>

        <div class="card">
            <div class="card-head"><h3>Quote to invoice</h3></div>
            <div class="table-wrap">
                <table class="data stack">
                    <thead><tr><th>Figure</th><th class="right">Amount</th><th>Source</th></tr></thead>
                    <tbody>
                        <tr>
                            <td data-label="Figure">Quoted total ex VAT</td>
                            <td data-label="Amount" class="right">@Fmt.Rand(q.Total)</td>
                            <td data-label="Source" class="small muted">Costing sheet</td>
                        </tr>
                        <tr>
                            <td data-label="Figure">VAT @@ 15%</td>
                            <td data-label="Amount" class="right">@Fmt.Rand(Math.Round(q.Total * 0.15m, 2))</td>
                            <td data-label="Source" class="small muted">Calculated</td>
                        </tr>
                        <tr class="total-row">
                            <td data-label="Figure">Quoted total incl VAT</td>
                            <td data-label="Amount" class="right">@Fmt.Rand(Math.Round(q.Total * 1.15m, 2))</td>
                            <td data-label="Source" class="small muted">Calculated</td>
                        </tr>
                        @if (Model.IsRecorded)
                        {
                            <tr>
                                <td data-label="Figure">Invoiced (Pastel)</td>
                                <td data-label="Amount" class="right strong">@Fmt.Rand(q.PastelInvoiceAmount!.Value)</td>
                                <td data-label="Source" class="small muted">@q.PastelInvoiceNo &middot; @Fmt.Date(q.PastelInvoiceDate!.Value)</td>
                            </tr>
                            <tr class="grand-row">
                                <td data-label="Figure">Variance</td>
                                <td data-label="Amount" class="right">
                                    @(Model.Variance >= 0 ? "+" : "\u2212")@Fmt.Rand(Math.Abs(Model.Variance))
                                </td>
                                <td data-label="Source" class="small">
                                    @(Math.Abs(Model.Variance) < 1m ? "Matches the quote" : "Differs from the quote \u2014 worth checking")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div>
        <div class="card totals">
            <div class="card-head"><h3>Scope note</h3></div>
            <div class="card-body">
                <p class="small" style="margin-top:0">
                    Generating the tax invoice was evaluated and left out of scope. Pastel is already
                    licensed, is the accounting book of record, and produces a compliant invoice with
                    sequential numbering &mdash; a legal requirement for VAT.
                </p>
                <p class="small">
                    Live integration was also investigated and rejected: Pastel Partner is on-premise
                    desktop software with SDK-gated access, which a cloud-hosted application cannot
                    reach without disproportionate infrastructure.
                </p>
                <div class="totals-note">
                    Customer records are seeded from a one-off Pastel export at cut-over, and the
                    invoice reference is recorded here. That keeps traceability without coupling the
                    two systems.
                </div>
            </div>
        </div>
    </div>
</div>