@model TechnoSurfacesApp.Controllers.QuotationVm
@{
    var q = Model.Quote;
    var cust = Db.GetCustomer(q.CustomerId);
    var contact = Db.GetContact(q.CustomerId, q.ContactId);
}

<div class="page-head no-print">
    <div>
        <h2>Customer quotation</h2>
        <p>@q.Ref &middot; @cust?.CompanyName</p>
    </div>
    <div class="page-head-actions">
        <a class="btn btn-secondary" asp-action="Costing" asp-route-id="@q.Id">
            <svg class="ico ico-sm"><use href="#i-arrow-left" /></svg> Costing sheet
        </a>
        <button class="btn btn-secondary" type="button" onclick="window.print()">
            <svg class="ico ico-sm"><use href="#i-print" /></svg> Print / PDF
        </button>
        <button class="btn btn-primary" type="button">Mark as sent</button>
    </div>
</div>

<div class="notice notice-good no-print">
    <svg class="ico"><use href="#i-check-circle" /></svg>
    <div>
        <strong>Safe to send.</strong> No cost price, supplier discount or markup appears anywhere on
        this document. Material and colour are shown because the customer chooses them &mdash;
        what those materials cost is not.
    </div>
</div>

@if (Model.LinesAreDraft)
{
    <div class="notice notice-warn no-print">
        <svg class="ico"><use href="#i-alert" /></svg>
        <div>
            <strong>Draft lines.</strong> These were composed from the costing total as a starting
            point. Customer-facing lines are normally written per room or element &mdash; edit them
            before sending.
        </div>
    </div>
}

<div class="doc">
    <div class="doc-top">
        <img src="~/img/logo.png" alt="Techno Surfaces" />
        <div class="doc-co">
            <strong>Techno Surfaces (Pty) Ltd</strong><br />
            Unit 1, Esvian Business Park<br />
            98D Bofors Circle, Epping 2, Cape Town<br />
            Tel (021) 534 0154 &middot; Fax (021) 534 0159<br />
            Reg. 2009/022153/07 &middot; VAT 4650255245<br />
            www.technosurfaces.co.za
        </div>
    </div>

    <div class="doc-title">Quotation</div>

    <div class="doc-meta">
        <dl>
            <dt>Attention</dt>
            <dd>@contact?.Name</dd>
            <dt>Company</dt>
            <dd>@cust?.CompanyName</dd>
            <dt>Tel</dt>
            <dd>@(contact?.Tel ?? "\u2014")</dd>
            <dt>Email</dt>
            <dd>@(contact?.Email ?? "\u2014")</dd>
        </dl>
        <dl>
            <dt>Ref</dt>
            <dd>@q.Ref</dd>
            <dt>Date</dt>
            <dd>@Fmt.Date(q.IssueDate)</dd>
            <dt>Site</dt>
            <dd>@q.Site</dd>
            <dt>Project</dt>
            <dd>@q.Project</dd>
            @if (!string.IsNullOrEmpty(q.CustomerReference))
            {
                <dt>Your ref</dt>
                <dd>@q.CustomerReference</dd>
            }
        </dl>
    </div>

    <table class="doc-lines">
        <thead>
            <tr>
                <th style="width:24%">Item</th>
                <th>Description</th>
                <th class="r" style="width:8%">Qty</th>
                <th class="r" style="width:14%">Rate</th>
                <th class="r" style="width:16%">Total</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var l in Model.Lines)
            {
                <tr class="@(l.IsNoteOnly ? "note" : "")">
                    <td><strong>@l.Item</strong></td>
                    <td>@l.Description</td>
                    <td class="r">@(l.Qty.HasValue ? Fmt.Qty(l.Qty.Value) : "")</td>
                    <td class="r">@(l.Rate.HasValue ? Fmt.Rand(l.Rate.Value) : "")</td>
                    <td class="r">@(l.IsNoteOnly ? "" : Fmt.Rand(l.LineTotal))</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="doc-totals">
        <div class="totals-row">
            <span class="lbl">Subtotal ex VAT</span>
            <span class="val">@Fmt.Rand(Model.SubTotal)</span>
        </div>
        @if (q.CustomerDiscountPct > 0)
        {
            <div class="totals-row">
                <span class="lbl">Discount @Fmt.Pct(q.CustomerDiscountPct)</span>
                <span class="val">&minus; @Fmt.Rand(Model.Discount)</span>
            </div>
            <div class="totals-row">
                <span class="lbl">Amount excl VAT</span>
                <span class="val">@Fmt.Rand(Model.ExVat)</span>
            </div>
        }
        <div class="totals-row">
            <span class="lbl">VAT @@ 15%</span>
            <span class="val">@Fmt.Rand(Model.Vat)</span>
        </div>
        <div class="totals-row grand" style="font-size:1.1rem">
            <span class="lbl">Total incl VAT</span>
            <span class="val">@Fmt.Rand(Model.IncVat)</span>
        </div>
    </div>

    <div class="doc-terms">
        <h4>Notes</h4>
        <ul>
            <li>Any span in carcass greater than 700mm must be re-enforced.</li>
        </ul>

        <h4>Lead times</h4>
        <ul>
            <li>
                Material: 2 working days if stock is available at suppliers; 6 to 8 weeks if not in
                stock and it needs to be imported.
            </li>
            <li>
                Production: 5 working days from acceptance of quotation in writing and payment of
                deposit if applicable.
            </li>
        </ul>

        <h4>Exclusions</h4>
        <ul>
            <li>Sealing between countertop and walls.</li>
            <li>Any plumbing or electrical work.</li>
            <li>Removal of existing worktops.</li>
        </ul>

        <h4>Terms and conditions</h4>
        <ul>
            <li><strong>This quotation is valid for 30 days only</strong> &mdash; until @Fmt.Date(q.ValidUntil).</li>
            <li>Damage caused by other parties or trades is charged as extra.</li>
            <li>No liability for negligent damage once handed over, or once signed &ldquo;Received in Good Order&rdquo;.</li>
            <li>
                No work commences until written acceptance and deposit paid, or an official order
                number for account customers.
            </li>
            <li>Prices exclude VAT and delivery unless stated.</li>
            <li>All pricing is subject to final measurement on site; changes are charged for.</li>
            <li>No contra charges, set off or retentions unless agreed in writing beforehand.</li>
        </ul>

        <h4>Disclaimers</h4>
        <ul>
            <li>No warranty where material is used in an application the manufacturer does not support.</li>
            <li>
                Solid dark colours scratch more easily than lighter speckled colours &mdash; not
                recommended for kitchen worktops or high-traffic areas.
            </li>
            <li>
                Veined or glitter colours may not give a seamless finish due to the directional
                nature of the material.
            </li>
            <li>No warranty where material is in direct sunlight or variable weather.</li>
        </ul>

        <h4>Warranty</h4>
        <table class="data" style="max-width:460px;font-size:.78rem">
            <thead><tr><th>Brand</th><th>Material</th><th>Workmanship</th></tr></thead>
            <tbody>
                @foreach (var w in Model.Warranties)
                {
                    <tr><td>@w.Brand</td><td>@w.Material</td><td>@w.Workmanship</td></tr>
                }
            </tbody>
        </table>
        <p class="small muted" style="margin-top:8px">Techno Surfaces is a DuPont certified installer.</p>

        <h4>Payment</h4>
        <ul>
            <li>60% deposit on order, balance on completion.</li>
            <li>ABSA Bank, Claremont, branch 632005, account 4075862554.</li>
        </ul>
    </div>

    <div class="doc-sign">
        <div><div class="line"></div><span>Signed</span></div>
        <div><div class="line"></div><span>Date</span></div>
        <div><div class="line"></div><span>Name of duly authorised person</span></div>
    </div>
</div>