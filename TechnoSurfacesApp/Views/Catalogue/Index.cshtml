@model TechnoSurfaces.Controllers.CatalogueVm

<div class="page-head">
    <div>
        <h2>Material catalogue</h2>
        <p>
            @Model.Entries.Count entr@(Model.Entries.Count == 1 ? "y" : "ies")
            @if (Model.AnyFilter)
            {
                <text>matching your filters</text>
            }
            else
            {

                <text>across @Db.Suppliers.Count suppliers</text>
            }
        </p>
    </div>
    <div class="page-head-actions">
        <a class="btn btn-secondary" asp-controller="Quotes" asp-action="Create">
            <svg class="ico ico-sm"><use href="#i-plus" /></svg> Quote a material
        </a>
        @if (Model.CanEditPrices)
        {
            <button class="btn btn-primary" type="button">
                <svg class="ico ico-sm"><use href="#i-plus" /></svg> Add entry
            </button>
        }
    </div>
</div>

@if (!Model.CanEditPrices)
{
    <div class="notice notice-info">
        <svg class="ico"><use href="#i-info" /></svg>
        <div>
            Everyone can see pricing &mdash; that is a deliberate decision by the client.
            <strong>Only the Managing Director can change a price.</strong>
        </div>
    </div>
}

@if (Model.StaleSupplierCount > 0)
{
    <div class="notice notice-warn">
        <svg class="ico"><use href="#i-alert" /></svg>
        <div>
            <strong>@Model.StaleSupplierCount supplier price list@(Model.StaleSupplierCount == 1 ? " is" : "s are") over a year old.</strong>
            Every price carries the date it came into effect &mdash; check that column before quoting
            from an old list.
        </div>
    </div>
}

<div class="grid grid-4" style="margin-bottom:20px">
    <div class="tile tile-accent">
        <div class="tile-label">Active entries</div>
        <div class="tile-value">@Db.ActiveEntryCount</div>
        <div class="tile-note">of @Db.Catalogue.Count total</div>
    </div>
    <div class="tile tile-accent blue">
        <div class="tile-label">Suppliers</div>
        <div class="tile-value">@Db.Suppliers.Count</div>
        <div class="tile-note">@Db.Suppliers.Count(s => s.PricingStructure == PricingStructure.Band) price by band, @Db.Suppliers.Count(s => s.PricingStructure == PricingStructure.Item) per item</div>
    </div>
    <div class="tile">
        <div class="tile-label">Product lines</div>
        <div class="tile-value">@Db.ProductLines.Count</div>
        <div class="tile-note">a colour can price differently in each</div>
    </div>
    <div class="tile tile-accent amber">
        <div class="tile-label">Phasing out</div>
        <div class="tile-value">@Db.Catalogue.Count(c => c.Status != CatalogueStatus.Active)</div>
        <div class="tile-note">retired, never deleted</div>
    </div>
</div>

<div class="card">
    <form method="get" class="filterbar">
        <div class="search">
            <svg class="ico ico-sm"><use href="#i-search" /></svg>
            <input class="input" name="q" value="@Model.Search" placeholder="Colour, code, range or band" />
        </div>

        <select class="select" name="supplierId" onchange="this.form.submit()">
            <option value="">All suppliers</option>
            @foreach (var s in Db.Suppliers.OrderBy(s => s.Name))
            {
                <option value="@s.Id" selected="@(Model.SupplierId == s.Id)">@s.Name</option>
            }
        </select>

        <select class="select" name="productLineId" onchange="this.form.submit()">
            <option value="">All materials</option>
            @foreach (var p in Model.ProductLineOptions)
            {
                <option value="@p.Id" selected="@(Model.ProductLineId == p.Id)">@p.Name</option>
            }
        </select>

        <select class="select" name="thickness" onchange="this.form.submit()">
            <option value="">Any thickness</option>
            @foreach (var t in Model.ThicknessOptions)
            {
                <option value="@t" selected="@(Model.Thickness == t)">@t mm</option>
            }
        </select>

        <select class="select" name="status" onchange="this.form.submit()">
            <option value="">Any status</option>
            @foreach (var st in Enum.GetValues<CatalogueStatus>())
            {
                <option value="@st" selected="@(Model.Status == st.ToString())">
                    @(st == CatalogueStatus.PhasingOut ? "Phasing out" : st.ToString())
                </option>
            }
        </select>

        <button class="btn btn-secondary btn-sm" type="submit">Apply</button>
        @if (Model.AnyFilter)
        {
            <a class="btn btn-ghost btn-sm" asp-action="Index">Clear</a>
        }
    </form>

    @if (Model.Entries.Count == 0)
    {
        <div class="empty">
            <svg class="ico"><use href="#i-search" /></svg>
            <h3>Nothing matches</h3>
            <p>Try widening the filters.</p>
            <a class="btn btn-secondary" asp-action="Index">Clear filters</a>
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="data stack">
                <thead>
                    <tr>
                        <th>Colour</th>
                        <th>Supplier &amp; material</th>
                        <th>Code</th>
                        <th>Sheet</th>
                        <th class="right">R / m&sup2;</th>
                        <th class="right">R / sheet</th>
                        <th class="right">Stock</th>
                        <th>Effective</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model.Entries)
                    {
                        var sup = Db.GetSupplier(e.SupplierId);
                        <tr>
                            <td data-label="Colour">
                                <div class="strong">@e.ColourName</div>
                                <div class="tiny muted">
                                    @if (e.BandCode is not null)
                                    {
                                        <span class="badge badge-band">@e.BandCode</span>
                                    }
                                    @if (e.Range is not null)
                                    {
                                        <span class="badge">@e.Range</span>
                                    }
                                    @if (e.Status != CatalogueStatus.Active)
                                    {
                                        <span class="badge badge-warn">@e.StatusLabel</span>
                                    }
                                </div>
                            </td>
                            <td data-label="Supplier &amp; material">
                                <div class="small">@Db.SupplierName(e.SupplierId)</div>
                                <div class="tiny muted">@Db.ProductLineName(e.ProductLineId)</div>
                            </td>
                            <td data-label="Code" class="mono tiny">
                                @(string.IsNullOrEmpty(e.SupplierCode) ? "\u2014" : e.SupplierCode)
                            </td>
                            <td data-label="Sheet" class="nowrap small">
                                @e.ShortSizeLabel
                                <div class="tiny muted">@e.ThicknessMm mm &middot; @Fmt.Num(e.SheetAreaSqm) m&sup2;</div>
                            </td>
                            <td data-label="R / m&sup2;" class="right">@Fmt.Rand(e.EffectivePricePerSqm)</td>
                            <td data-label="R / sheet" class="right strong">
                                @Fmt.Rand(e.EffectivePricePerSheet)
                                @if (!e.PublishedPricePerSheet.HasValue)
                                {
                                    <div class="tiny muted">derived</div>
                                }
                            </td>
                            <td data-label="Stock" class="right">
                                @(e.StockQty.HasValue ? Fmt.Qty(e.StockQty.Value) : "\u2014")
                            </td>
                            <td data-label="Effective" class="small nowrap">
                                @Fmt.Date(e.EffectiveFrom)
                                @if (sup is { IsStale: true })
                                {
                                    <div><span class="badge badge-warn">Old list</span></div>
                                }
                            </td>
                            <td data-label="" class="right">
                                <a class="btn btn-ghost btn-sm" asp-action="Price" asp-route-id="@e.Id">
                                    @(Model.CanEditPrices ? "Edit price" : "View")
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>