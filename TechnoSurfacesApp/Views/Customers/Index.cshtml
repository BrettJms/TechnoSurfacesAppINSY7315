@model TechnoSurfaces.Controllers.CustomerListVm

<div class="page-head">
    <div>
        <h2>Customers</h2>
        <p>@Model.Rows.Count customers &middot; @Model.TotalContacts contacts &middot; @Fmt.Rand(Model.TotalValue) quoted</p>
    </div>
    <div class="page-head-actions">
        @if (Model.CanManage)
        {
            <button class="btn btn-primary" type="button">
                <svg class="ico ico-sm"><use href="#i-plus" /></svg> Add customer
            </button>
        }
    </div>
</div>

<div class="notice notice-info">
    <svg class="ico"><use href="#i-info" /></svg>
    <div>
        Customer records are seeded from a <strong>one-off Pastel Customer Masterfile export</strong>
        at cut-over. Live integration with Pastel was investigated and rejected &mdash; it is
        on-premise desktop software behind a licensed SDK.
    </div>
</div>

<div class="card">
    <form method="get" class="filterbar">
        <div class="search">
            <svg class="ico ico-sm"><use href="#i-search" /></svg>
            <input class="input" name="q" value="@Model.Search" placeholder="Company, account code or contact" />
        </div>
        <button class="btn btn-secondary btn-sm" type="submit">Search</button>
        @if (!string.IsNullOrWhiteSpace(Model.Search))
        {
            <a class="btn btn-ghost btn-sm" asp-action="Index">Clear</a>
        }
    </form>

    @if (Model.Rows.Count == 0)
    {
        <div class="empty">
            <svg class="ico"><use href="#i-building" /></svg>
            <h3>No customers match</h3>
            <p>Try a different search term.</p>
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="data stack">
                <thead>
                    <tr>
                        <th>Company</th>
                        <th>Account</th>
                        <th>VAT no.</th>
                        <th class="right">Contacts</th>
                        <th class="right">Quotes</th>
                        <th>Last quoted</th>
                        <th class="right">Value quoted</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Rows)
                    {
                        <tr>
                            <td data-label="Company">
                                <a class="row-link" asp-action="Details" asp-route-id="@r.Customer.Id">
                                    @r.Customer.CompanyName
                                </a>
                                <div class="tiny muted">@r.Customer.BillingAddress</div>
                            </td>
                            <td data-label="Account" class="mono tiny">@r.Customer.AccountCode</td>
                            <td data-label="VAT no." class="mono tiny">@(r.Customer.VatNumber ?? "\u2014")</td>
                            <td data-label="Contacts" class="right">@r.Customer.Contacts.Count</td>
                            <td data-label="Quotes" class="right">@r.Quotes.Count</td>
                            <td data-label="Last quoted" class="small nowrap">
                                @(r.LastQuoted.HasValue ? Fmt.Date(r.LastQuoted.Value) : "\u2014")
                            </td>
                            <td data-label="Value quoted" class="right strong">@Fmt.Rand(r.TotalValue)</td>
                            <td data-label="" class="right">
                                <a class="btn btn-ghost btn-sm" asp-action="Details" asp-route-id="@r.Customer.Id">Open</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>