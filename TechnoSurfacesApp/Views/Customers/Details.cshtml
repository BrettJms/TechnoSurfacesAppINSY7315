@model TechnoSurfaces.Controllers.CustomerDetailVm
@{
    var c = Model.Customer;
}

<div class="page-head">
    <div>
        <h2>@c.CompanyName</h2>
        <p>
            Account @c.AccountCode @if (c.VatNumber is not null) {
            <text>&middot; VAT @c.VatNumber</text>
        }
    </p>
</div>
<div class="page-head-actions">
    <a class="btn btn-secondary" asp-action="Index">
        <svg class="ico ico-sm"><use href="#i-arrow-left" /></svg> Customers
    </a>
    <a class="btn btn-primary" asp-controller="Quotes" asp-action="Create">
        <svg class="ico ico-sm"><use href="#i-plus" /></svg> New quote
    </a>
</div>
</div>

<div class="grid grid-3" style="margin-bottom:20px">
    <div class="tile tile-accent blue">
        <div class="tile-label">Quotes</div>
        <div class="tile-value">@Model.Quotes.Count</div>
        <div class="tile-note">@Model.OpenCount still open</div>
    </div>
    <div class="tile tile-accent">
        <div class="tile-label">Accepted value</div>
        <div class="tile-value">@Fmt.Rand(Model.WonValue)</div>
        <div class="tile-note">of @Fmt.Rand(Model.TotalValue) quoted</div>
    </div>
    <div class="tile">
        <div class="tile-label">Contacts</div>
        <div class="tile-value">@c.Contacts.Count</div>
        <div class="tile-note">people who send requests</div>
    </div>
</div>

<div class="grid grid-main">
    <div>
        <div class="card">
            <div class="card-head">
                <svg class="ico" style="color:var(--ts-blue)"><use href="#i-file" /></svg>
                <h2>Quote history</h2>
            </div>

            @if (Model.Quotes.Count == 0)
            {
                <div class="empty">
                    <svg class="ico"><use href="#i-file" /></svg>
                    <h3>No quotes yet</h3>
                    <p>Nothing has been quoted for this customer.</p>
                    <a class="btn btn-primary" asp-controller="Quotes" asp-action="Create">New quote</a>
                </div>
            }
            else
            {
                <div class="table-wrap">
                    <table class="data stack">
                        <thead>
                            <tr>
                                <th>Quote</th>
                                <th>Project</th>
                                <th>Estimator</th>
                                <th>Status</th>
                                <th class="right">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var q in Model.Quotes)
                            {
                                <tr>
                                    <td data-label="Quote">
                                        <a class="row-link" asp-controller="Quotes" asp-action="Costing" asp-route-id="@q.Id">@q.Ref</a>
                                        <div class="tiny muted">@Fmt.Date(q.IssueDate)</div>
                                    </td>
                                    <td data-label="Project">
                                        <div class="small">@q.Project</div>
                                        <div class="tiny muted">@q.Site</div>
                                    </td>
                                    <td data-label="Estimator" class="small">@Db.UserName(q.OwnerUserId)</td>
                                    <td data-label="Status">
                                        <span class="pill pill-@q.StatusKey">@q.StatusLabel</span>
                                        @if (q.PastelInvoiceNo is not null)
                                        {
                                            <div class="tiny muted">@q.PastelInvoiceNo</div>
                                        }
                                    </td>
                                    <td data-label="Total" class="right strong">@Fmt.Rand(q.Total)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div>
        <div class="card">
            <div class="card-head">
                <svg class="ico" style="color:var(--ts-sage)"><use href="#i-users" /></svg>
                <h3>Contacts</h3>
                <span class="spacer"></span>
                @if (Model.CanManage)
                {
                    <button class="btn btn-ghost btn-sm" type="button">
                        <svg class="ico ico-sm"><use href="#i-plus" /></svg>
                    </button>
                }
            </div>
            <div class="card-body" style="padding:8px 0">
                @foreach (var k in c.Contacts)
                {
                    <div style="display:flex;gap:11px;padding:11px 20px;border-bottom:1px solid var(--line-2)">
                        <span class="avatar sage" style="width:32px;height:32px;flex-basis:32px;font-size:.68rem">
                            @string.Concat(k.Name.Split(' ').Take(2).Select(p => p[0]))
                        </span>
                        <div style="min-width:0">
                            <div class="small strong">@k.Name</div>
                            @if (k.JobTitle is not null)
                            {
                                <div class="tiny muted">@k.JobTitle</div>
                            }
                            <div class="tiny muted" style="margin-top:3px">@k.Tel</div>
                            <div class="tiny muted">@k.Email</div>
                        </div>
                    </div>
                }
            </div>
            <div class="card-foot">
                <span class="tiny muted">
                    A quote is addressed to a contact, not a company &mdash; some customers have
                    four or five people who send requests.
                </span>
            </div>
        </div>

        <div class="card">
            <div class="card-head"><h3>Account</h3></div>
            <div class="card-body">
                <div class="field">
                    <label class="label">Billing address</label>
                    <div class="small">@c.BillingAddress</div>
                </div>
                <div class="field">
                    <label class="label">Pastel account code</label>
                    <div class="small mono">@c.AccountCode</div>
                </div>
                <div class="field">
                    <label class="label">VAT number</label>
                    <div class="small mono">@(c.VatNumber ?? "Not registered")</div>
                </div>
                <div class="hint">
                    Delivery addresses are held per quote, not here &mdash; the bill-to and
                    deliver-to on a job are often different.
                </div>
            </div>
        </div>
    </div>
</div>