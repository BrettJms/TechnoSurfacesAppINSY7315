@model TechnoSurfacesApp.Models.LoginViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Sign in";
    var formError = ViewData.ModelState[string.Empty]?.Errors.FirstOrDefault()?.ErrorMessage;
}

<h1>Sign in</h1>
<p class="lede">Use the credentials issued to you by the Managing Director.</p>

@if (formError is not null)
{
    <div class="notice notice-alert" role="alert" style="margin-bottom:18px">
        <svg class="ico"><use href="#i-alert" /></svg>
        <div>@formError</div>
    </div>
}

<form asp-action="Login" method="post">
    <input type="hidden" asp-for="ReturnUrl" />

    <div class="field">
        <label class="label" asp-for="Email"></label>
        <input class="input" asp-for="Email" type="email" autocomplete="username"
               placeholder="you@technosurfaces.co.za" />
        <span class="hint" style="color:var(--danger)" asp-validation-for="Email"></span>
    </div>

    <div class="field">
        <label class="label" asp-for="Password"></label>
        <input class="input" asp-for="Password" autocomplete="current-password" />
        <span class="hint" style="color:var(--danger)" asp-validation-for="Password"></span>
        <div class="hint">
            <a asp-action="ForgotPassword">Forgotten your password?</a>
        </div>
    </div>

    <div class="field">
        <label class="check">
            <input asp-for="RememberMe" />
            <span>Keep me signed in on this device</span>
        </label>
    </div>

    <button class="btn btn-primary btn-lg btn-block" type="submit">
        Sign in
        <svg class="ico ico-sm"><use href="#i-chevron-right" /></svg>
    </button>
</form>

<div class="notice notice-info" style="margin-top:26px">
    <svg class="ico"><use href="#i-lock" /></svg>
    <div>
        <strong>Accounts are created by the Managing Director.</strong>
        There is no public registration &mdash; if you need access, ask Paul to
        create an account for you.
    </div>
</div>