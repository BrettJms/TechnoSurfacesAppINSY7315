@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Reset password";
    var sent = ViewData["Sent"] as bool? ?? false;
}

@if (!sent)
{
    <a class="btn btn-ghost btn-sm" asp-action="Login" style="margin-bottom:16px;padding-left:0">
        <svg class="ico ico-sm"><use href="#i-arrow-left" /></svg> Back to sign in
    </a>

    <h1>Reset your password</h1>
    <p class="lede">
        Enter your work email address and we'll send you a link to set a new password.
        The link expires after 30 minutes.
    </p>

    <form asp-action="ForgotPassword" method="post">
        <div class="field">
            <label class="label" for="email">Email address</label>
            <input class="input" id="email" name="email" type="email"
                   placeholder="you@technosurfaces.co.za" required />
        </div>

        <button class="btn btn-primary btn-lg btn-block" type="submit">Send reset link</button>
    </form>

    <div class="notice notice-info" style="margin-top:24px">
        <svg class="ico"><use href="#i-info" /></svg>
        <div>
            No email arriving? Only accounts created by the Managing Director can
            reset a password. Ask Paul to confirm your account is active.
        </div>
    </div>
}
else
{
    <div style="text-align:center">
        <div class="avatar sage lg" style="margin:0 auto 16px;width:52px;height:52px;flex-basis:52px">
            <svg class="ico ico-lg"><use href="#i-check" /></svg>
        </div>
        <h1>Check your inbox</h1>
        <p class="lede">
            If <strong>@ViewData["Email"]</strong> matches an active account, a reset
            link is on its way. It expires in 30 minutes.
        </p>
        <a class="btn btn-secondary btn-block" asp-action="Login">Back to sign in</a>
    </div>
}